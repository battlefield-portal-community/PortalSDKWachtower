# Discord webhook the watchtower pings on a new SDK version.
DISCORD_WEBHOOK_URL=

# Optional: path to the version lock file (defaults to version.lock).
# LOCK_FILE_PATH=version.lock

# Optional polling tuning (defaults shown). Healthy polls are cheap conditional
# 304s, so the interval stays short for fast detection; failures back off
# exponentially up to the cap.
# POLL_INTERVAL_SECONDS=10
# REQUEST_TIMEOUT_SECONDS=15
# MAX_BACKOFF_SECONDS=300

# Optional: skip individual side effects (all default to false).
# SKIP_R2_UPLOAD=false
# SKIP_R2_MAPPING_UPDATE=false
# SKIP_LOCAL_MAPPING_UPDATE=false

# Cloudflare R2 (S3-compatible) credentials used to upload new SDKs and to
# update the versions.json mapping the Worker reads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
