# Discord webhook the watchtower pings on a new SDK version.
DISCORD_WEBHOOK_URL=

# Optional: path to the version lock file (defaults to version.lock).
# LOCK_FILE_PATH=version.lock

# Cloudflare R2 (S3-compatible) credentials used to upload new SDKs and to
# update the versions.json mapping the Worker reads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
